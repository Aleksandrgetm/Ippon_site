PORT=3000
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_MAX_REQUEST_SIZE_MB=500
UPLOAD_MAX_FILES=100
UPLOAD_TIMEOUT_MS=600000
# Optional: override SQLite path. Default is ./data/ippon.db
# DB_PATH=./data/ippon.db
# Spaces / DigitalOcean
# SPACES_BUCKET=ippon
# SPACES_REGION=fra1
# SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
# SPACES_PUBLIC_BASE=https://ippon.fra1.digitaloceanspaces.com
# SPACES_KEY=your_spaces_key
# SPACES_SECRET=your_spaces_secret
